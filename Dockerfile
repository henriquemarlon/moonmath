# syntax=docker/dockerfile:1

# Adapt Docker Init's Python recipe to the native Conda distribution used by Sage.
ARG MINIFORGE_IMAGE=condaforge/miniforge3:26.9.4-0@sha256:63d72eadf0ab73ee63bad8f5cfdfe1754530415b4aeba99e466e9a6f77ceec95
FROM ${MINIFORGE_IMAGE} AS base

# Avoid generated bytecode in mounted notebooks and emit Python logs immediately.
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Create a non-root user with a writable home for Jupyter and Sage configuration.
ARG APP_UID=10001
RUN useradd --uid "${APP_UID}" --create-home --shell /bin/bash sage \
    && mkdir -p /home/sage/notebooks \
    && chown sage:sage /home/sage/notebooks
WORKDIR /home/sage/notebooks

# Install locked native packages separately, reusing downloads across rebuilds.
# The lock is read-only during the build; the package cache stays out of the image.
RUN --mount=type=cache,id=zk01-conda-linux-aarch64,target=/opt/conda/pkgs,sharing=locked \
    --mount=type=bind,source=conda-linux-aarch64.lock,target=/tmp/conda.lock \
    mamba create --yes --name sage --file /tmp/conda.lock

ENV PATH="/opt/conda/envs/sage/bin:${PATH}"
USER sage

# Compose publishes this port only on the host's localhost.
EXPOSE 8888

# Activate Conda before starting Jupyter; keep its default token authentication.
ENTRYPOINT ["/bin/bash", "-c", "source /opt/conda/etc/profile.d/conda.sh && conda activate sage && exec \"$@\"", "--"]
CMD ["jupyter", "notebook", "--no-browser", "--ip=0.0.0.0", \
     "--port=8888", "--port-retries=0", "--notebook-dir=/home/sage/notebooks"]
